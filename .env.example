# Copy to .env.local and fill in whichever you have. Every integration
# degrades gracefully when its keys are missing — the relevant page section
# just shows "Not connected" instead of throwing. See README.md for the
# full list and what each one unlocks.

ARTIST_LOGIN_PASSWORD=

# --- Free, self-serve, keyless (no vars needed) -----------------------
# MusicBrainz + Wikidata work with no credentials at all. Google Trends too,
# though it's Google's unofficial internal endpoint and can be flaky.
#
# Kworb is also auth-free, but its URLs are keyed by Spotify artist ID
# (kworb.net/spotify/artist/<id>_songs.html) and there's no keyless way to
# look that ID up. Without SPOTIFY_CLIENT_ID/SECRET below, Kworb needs
# CHARLI_SPOTIFY_ARTIST_ID set manually (see bottom of this file) or it
# stays "Not connected" — that's the one override that's often required,
# not just a disambiguation fallback. Get the ID from the artist's Spotify
# page: Share > Copy Link to Artist, then take the id after /artist/.

# --- Free, self-serve, need a developer signup -------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

YOUTUBE_API_KEY=

GENIUS_ACCESS_TOKEN=

SETLISTFM_API_KEY=

DISCOGS_TOKEN=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Paid, requires an active subscription ------------------------------
CHARTMETRIC_REFRESH_TOKEN=
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# --- Free, needed for the Ideas tab -------------------------------------
# The only tab with shared, editable, team-wide state (everyone sees the
# same ideas and the same liked/disliked piles) - everything else on this
# site is either read-only live data or per-browser localStorage (see
# Strategy). That needs real storage, which this project doesn't otherwise
# have: a private GitHub Gist acts as a lightweight JSON "database" for the
# idea records (images are embedded as base64 inside it too), so no hosting
# dashboard or storage product is needed - just a token and a gist ID.
#
# 1. Create a token: github.com/settings/tokens/new, tick only the "gist"
#    scope, generate, paste it below as IDEAS_GIST_TOKEN.
# 2. Create a gist: gist.github.com, add one file named
#    "ideas-manifest.json" with the content "[]", save as a secret gist.
#    Copy the ID from the URL (gist.github.com/<user>/<THIS PART>) into
#    IDEAS_GIST_ID below.
#
# Without both set, the Ideas tab shows "Not connected" instead of the
# swipe deck.
IDEAS_GIST_TOKEN=
IDEAS_GIST_ID=

# --- Contact info sent in User-Agent headers (required by MusicBrainz's
#     usage policy; polite to set for Wikidata too) ---------------------
MUSICBRAINZ_CONTACT=
WIKIDATA_CONTACT=

# --- Only set these if auto-resolution picks the wrong entity ----------
# CHARLI_MUSICBRAINZ_MBID=
# CHARLI_WIKIDATA_QID=
# CHARLI_SPOTIFY_ARTIST_ID=
# CHARLI_YOUTUBE_CHANNEL_ID=
# CHARLI_GENIUS_ARTIST_ID=
# CHARLI_DISCOGS_ARTIST_ID=
# CHARLI_SUBREDDIT=charlixcx
